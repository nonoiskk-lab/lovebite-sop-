# ─── Supabase (public client keys) ──────────────────────────────────────────
# The app falls back to the live project's values in src/lib/supabase/config.ts,
# so these are optional locally. Set them in Vercel (Project → Settings → Env)
# to override per environment. The anon key is a public client key (safe to
# expose); RLS is the real access boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin — used to build OAuth / email redirect URLs.
# e.g. https://lovebite-sop.vercel.app  (or http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=

# ─── Server-only (NEVER expose to the client / never commit real value) ──────
# Used only in Server Actions / Route Handlers for admin tasks such as inviting
# staff or assigning roles. Set in Vercel as a non-public env var.
SUPABASE_SERVICE_ROLE_KEY=
